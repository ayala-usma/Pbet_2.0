###############################################################################
# Keep important project files
###############################################################################

!.gitignore
!Snakefile
!workflow/**
!rules/**
!scripts/**
!config/**
!envs/**
!profiles/**
!resources/**

# Keep documentation
!README.md
!LICENSE
!docs/**

# Keep Conda environment specifications
!environment.yml
!environment.yaml
!*.yml
!*.yaml