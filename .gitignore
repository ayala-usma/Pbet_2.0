###############################################################################
# Snakemake
###############################################################################

# Snakemake working directory
.snakemake/

# Rule logs (if stored in a logs/ directory)
logs/
log/
*.log

# Benchmark outputs
benchmarks/
benchmark/

# Temporary files
tmp/
temp/
*.tmp
*.temp

###############################################################################
# Conda / Mamba / Micromamba
###############################################################################

# Local environments
.conda/
conda/
env/
envs/
ENV/
venv/
.venv/
mamba/
micromamba/

# Conda package cache
pkgs/

###############################################################################
# Python
###############################################################################

__pycache__/
*.py[cod]
*$py.class

# Compiled extensions
*.so
*.pyd
*.dll

# Packaging
build/
dist/
downloads/
.eggs/
*.egg-info/
.eggs/
pip-wheel-metadata/

